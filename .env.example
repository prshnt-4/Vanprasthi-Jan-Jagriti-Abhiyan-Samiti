# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/vanprasthi_samiti_db

# Auth Secret
JWT_SECRET=super_secret_jwt_key_vanprasthi_samiti_2026_Uttarakhand

# Admin Credentials (Initial setup)
ADMIN_EMAIL=admin@vanprasthisamiti.org
ADMIN_PASSWORD=AdminPass@2026!

# Payment Gateway Configuration
# Enable Mock Payment Mode when Razorpay keys are not provided
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Image & File Storage (Cloudinary optional, local storage fallback integrated)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
